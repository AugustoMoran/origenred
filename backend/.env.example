# Backend environment variables (example)
PORT=4000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/<db>?retryWrites=true&w=majority

# Auth
JWT_ACCESS_TOKEN_SECRET=<tu-secreto-largo-1>
JWT_REFRESH_TOKEN_SECRET=<tu-secreto-largo-2>

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Branding para PDFs (Factura/Remito)
# En cloud podés usar una ruta montada o dejar fallback al logo del frontend
# BRAND_LOGO_PATH=/opt/render/project/src/frontend/public/brand-logo.png

# =============================
# AFIP - Local (paths)
# =============================
COMPANY_CUIT=20123456789
AFIP_PTO_VTA=1
ENABLE_AFIP_QUEUE=true
REDIS_URL=redis://localhost:6379
AFIP_CERT_PATH=../secure/afip/tu-certificado.crt
AFIP_KEY_PATH=../secure/afip/private.key

# =============================
# AFIP - Render/Cloud (PEM env)
# Prefer these in production
# =============================
# AFIP_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AFIP_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# =============================
# AFIP - Production mode
# =============================
AFIP_PRODUCTION=true

# =============================
# MercadoPago
# =============================
MERCADOPAGO_ACCESS_TOKEN=<mercadopago_access_token>
MERCADOPAGO_PUBLIC_KEY=<mercadopago_public_key>
# MERCADOPAGO_WEBHOOK_URL=https://<tu-backend>/api/payments/mercadopago/webhook
