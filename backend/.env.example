# OrigenRed — Backend environment variables (example)
PORT=4000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/origenred?retryWrites=true&w=majority&appName=Cluster0

# Auth
JWT_ACCESS_TOKEN_SECRET=<secreto-largo-aleatorio-1>
JWT_REFRESH_TOKEN_SECRET=<secreto-largo-aleatorio-2>

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
# Deep link scheme Expo (back_urls Mercado Pago desde app mobile)
MOBILE_APP_SCHEME=origenred
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudflare R2 (S3-compatible — imágenes marketplace)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=origenred-media
R2_PUBLIC_URL=https://<cdn-o-dominio-publico>
CLOUDFLARE_API_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch (búsqueda avanzada — activa al configurar host + API key)
# Docker local: master key por defecto en docker-compose (MEILI_MASTER_KEY)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Mercado Pago Connect (OAuth + split de pagos)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Debe coincidir con "URLs de redireccionamiento" en MP Developers (opcional si FRONTEND_URL es correcto)
MERCADOPAGO_OAUTH_REDIRECT_URI=https://origenred.com/vendedor/mercadopago/callback
MERCADOPAGO_WEBHOOK_URL=https://<backend>/api/marketplace/checkout/webhook
MERCADOPAGO_PLATFORM_FEE_PERCENT=5

# EnvíoPack
ENVIOPACK_API_KEY=
ENVIOPACK_SECRET=
ENVIOPACK_TRANSFER_COMPANY=ENVIOPACK S.A
ENVIOPACK_TRANSFER_CUIT=30-71521308-3
ENVIOPACK_TRANSFER_BANK=BIND
ENVIOPACK_TRANSFER_ACCOUNT=1-695143/1
ENVIOPACK_TRANSFER_CBU=3220001805006951430018
ENVIOPACK_TRANSFER_ALIAS=
# Depósito OrigenRed (retiro/cotización para ventas del admin en marketplace)
ENVIOPACK_ORIGIN_STREET=
ENVIOPACK_ORIGIN_CITY=CABA
ENVIOPACK_ORIGIN_PROVINCE=Buenos Aires
ENVIOPACK_ORIGIN_POSTAL_CODE=1425
ENVIOPACK_ORIGIN_LABEL=Depósito OrigenRed
# ID del depósito en EnvíoPack (Configuración > Depósitos) para retiro/cotización ventas admin
ENVIOPACK_PLATFORM_DIRECCION_ENVIO_ID=

# Marketplace
MARKETPLACE_COMMISSION_PERCENT=5
MAX_LISTINGS_PER_SELLER=100

# Panel admin propio — AFIP / facturación interna (opcional)
ENABLE_AFIP_QUEUE=false
COMPANY_CUIT=
COMPANY_NAME=OrigenRed
AFIP_PTO_VTA=1
AFIP_PRODUCTION=false
AFIP_CERT_PATH=
AFIP_KEY_PATH=
