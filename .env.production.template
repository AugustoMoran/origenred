# =========================================================
# PLATAFORMA DE FACTURACION - TEMPLATE PRODUCCION
# =========================================================
# Uso recomendado:
# - Render (backend): copiar todas EXCEPTO VITE_API_URL
# - Vercel (frontend): usar solo VITE_API_URL

# -------------------------
# Runtime
# -------------------------
NODE_ENV=production
PORT=4000

# -------------------------
# Backend - Base de datos
# -------------------------
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appName>

# -------------------------
# Backend - Seguridad JWT
# -------------------------
JWT_ACCESS_TOKEN_SECRET=<JWT_ACCESS_TOKEN_SECRET_LARGO_Y_ALEATORIO>
JWT_REFRESH_TOKEN_SECRET=<JWT_REFRESH_TOKEN_SECRET_LARGO_Y_ALEATORIO>

# -------------------------
# Backend - CORS / Frontend
# -------------------------
FRONTEND_URL=https://<tu-frontend>.vercel.app
CORS_ALLOWED_ORIGINS=https://<tu-frontend>.vercel.app,https://*.vercel.app

# -------------------------
# Backend - Cola AFIP (BullMQ + Redis)
# -------------------------
ENABLE_AFIP_QUEUE=true
REDIS_URL=redis://default:<password>@<host>:<port>
AFIP_ENQUEUE_TIMEOUT_MS=4000

# -------------------------
# Backend - Datos de empresa
# -------------------------
COMPANY_NAME=<RAZON_SOCIAL>
COMPANY_CUIT=<CUIT_SOLO_NUMEROS>
COMPANY_ADDRESS=<DIRECCION_FISCAL>
COMPANY_EMAIL=<EMAIL_FACTURACION>

# -------------------------
# Backend - AFIP
# -------------------------
AFIP_PTO_VTA=1
AFIP_PRODUCTION=true

# Opcion A (RECOMENDADA en cloud): PEM en variables
# Usa \n para saltos de linea al pegar en una sola linea
AFIP_CERT_PEM=-----BEGIN CERTIFICATE-----\n<contenido_certificado>\n-----END CERTIFICATE-----
AFIP_KEY_PEM=-----BEGIN PRIVATE KEY-----\n<contenido_clave_privada>\n-----END PRIVATE KEY-----

# Opcion B (fallback para local/volumenes)
# AFIP_CERT_PATH=../secure/afip/tu-certificado.crt
# AFIP_KEY_PATH=../secure/afip/private.key

# Opcionales avanzadas
AFIP_WSAA_URL=
AFIP_WSFE_URL=

# -------------------------
# Backend - Cloudinary
# -------------------------
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# -------------------------
# Backend - Branding PDF
# -------------------------
BRAND_LOGO_PATH=

# -------------------------
# Frontend (Vercel)
# -------------------------
VITE_API_URL=https://<tu-backend>.onrender.com/api

# -------------------------
# Backend - MercadoPago
# -------------------------
MERCADOPAGO_ACCESS_TOKEN=<MERCADOPAGO_ACCESS_TOKEN>
MERCADOPAGO_PUBLIC_KEY=<MERCADOPAGO_PUBLIC_KEY>
# MERCADOPAGO_WEBHOOK_URL=https://<tu-backend>.onrender.com/api/payments/mercadopago/webhook
