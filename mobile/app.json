{
  "expo": {
    "name": "OrigenRed",
    "slug": "origenred",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "origenred",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e3a5f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.origenred.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f"
      },
      "package": "com.origenred.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "origenred" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1e3a5f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OrigenRed necesita acceso a tus fotos para subir imágenes de productos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c4e8a1b2-3d4f-5a6b-7c8d-9e0f1a2b3c4d"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
